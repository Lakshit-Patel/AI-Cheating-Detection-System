# ProctorAI Environment Configuration Template
APP_ENV=development
APP_NAME="Online Cheating Preventer API"

# Secret key for JWT signing. Generate using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string-for-production

# Database URL (SQLite for local dev, PostgreSQL for production/docker)
DATABASE_URL=sqlite:///./proctor.db
# DATABASE_URL=postgresql+psycopg2://proctor:password@localhost:5432/proctor

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8000,http://localhost:8000

# Token Lifespans
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frame Size Limits (2MB default)
MAX_FRAME_BYTES=2097152

# PostgreSQL Connection Pool (ignored on SQLite)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20


# --- Detector tuning (starting values; validate on a real webcam) ---
YAW_THRESHOLD_DEG=20
LOOK_UP_THRESHOLD_DEG=18
LOOK_DOWN_THRESHOLD_DEG=25
DIRECTION_ENTER_FRAMES=3
DIRECTION_CLEAR_FRAMES=3
CALIBRATION_SAMPLES=20
CALIBRATION_TIMEOUT_SECONDS=20
PHONE_CONF_THRESHOLD=0.45
YOLO_MODEL_PATH=yolov8n.pt
